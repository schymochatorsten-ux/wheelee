[Unit]
Description=wheelee Datenlauf täglich (ToDo 19.2, 19.10)

[Timer]
# Nach der Sicherung (03:30), vor dem Morgen. Der Lauf ist an den meisten Tagen
# nach einer halben Minute fertig (nur Prüfung, kein Import).
OnCalendar=*-*-* 04:30:00
Persistent=true
# Overpass, Nominatim und die Portale gehören Freiwilligen oder Städten
# (CLAUDE.md): nicht alle zur selben Minute.
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
