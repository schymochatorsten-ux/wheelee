[Unit]
Description=wheelee Datenlauf: Quellen prüfen, geänderte amtliche Städte neu importieren (ToDo 19.2, 19.10)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Über `sh` und nicht direkt: Das Repository wird unter Windows gepflegt und
# trägt kein Ausführbar-Bit (siehe deploy/README.md, „Warum bash deploy.sh“).
ExecStart=/bin/sh /opt/wheelee/deploy/wheelee-aktualitaet.sh
User=niklas
Group=niklas
SupplementaryGroups=docker
NoNewPrivileges=true

# Ein Hintergrundlauf soll die App und die übrigen Dienste auf dem NAS nicht
# spürbar bremsen. Die Last macht der Container (dort sind 1 CPU und 1 GB
# gedeckelt); hier die Priorität des Skripts selbst.
Nice=19
IOSchedulingClass=idle

# Geänderte Daten nach origin/main pushen (löst den Deploy aus). Mit 0 bleibt
# der Stand auf dem Zweig daten-update im Klon.
Environment=WHEELEE_AUTO_PUSH=1
# Weitere Schalter (Voreinstellungen, nur bei Bedarf ändern):
#   Environment=WHEELEE_VALIDIERUNG_MONATE=01 07
#   Environment=WHEELEE_CPUS=1
#   Environment=WHEELEE_MAX_DATEIEN=40

# Der Lauf wartet auf Fremddienste (Nominatim: eine Anfrage je Sekunde,
# Overpass mit Pausen). Der Erstlauf mit neun Städten dauerte rund eine Stunde.
TimeoutStartSec=4h
